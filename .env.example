# Google AI Studio / Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Centralized Model Role Policy (optional overrides)
GEMINI_MODEL_FAST=gemini-3.5-flash
GEMINI_MODEL_REASONING=gemini-3.5-flash
GEMINI_MODEL_STRUCTURED=gemini-3.5-flash
GEMINI_MODEL_QA=gemini-3.5-flash

# Execution & Testing Safety
# When false (default), tests mock the network and never consume Gemini quota.
RUN_LIVE_PROVIDER_TESTS=false
